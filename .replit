modules = ["nodejs-20", "python-3.10"]
[agent]
expertMode = true

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 3002

[[ports]]
localPort = 8084
externalPort = 3003

[[ports]]
localPort = 8085
externalPort = 4200

[[ports]]
localPort = 8086
externalPort = 5000

[[ports]]
localPort = 8087
externalPort = 5173

[[ports]]
localPort = 23984
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Music Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "JioSaavn Sidecar API"

[[workflows.workflow]]
name = "Music Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd musicbot && export PATH=$HOME/.deno/bin:$PATH && uv run --python 3.10 python3 -m anony"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "JioSaavn Sidecar API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd musicbot/jiosaavn-sidecar-clean/artifacts/api-server && node --enable-source-maps ./dist/index.mjs"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
JIOSAVAN_API_URL = "http://127.0.0.1:8080"
ARC_API_URL = "https://api.arcmusic.fun"
